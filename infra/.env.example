MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_DATABASE=ad_platform
MYSQL_USER=ad_platform
MYSQL_PASSWORD=replace-with-a-strong-database-password

DATABASE_URL=mysql+pymysql://ad_platform:replace-with-a-strong-database-password@mysql:3306/ad_platform
DB_DSN=ad_platform:replace-with-a-strong-database-password@tcp(mysql:3306)/ad_platform?parseTime=true
DATA_SOURCE_NAME=exporter:replace-with-an-exporter-password@(mysql:3306)/

# Generate independent random values. Never commit production values.
SECRET_KEY=replace-with-at-least-32-random-characters
MFA_ENCRYPTION_KEY=replace-with-a-separate-random-encryption-key
JWT_ISSUER=ad-platform-auth
JWT_AUDIENCE=ad-platform
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
INTERNAL_SERVICE_TOKEN=replace-with-a-random-service-token
REDIS_URL=redis://redis:6379/0

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=replace-with-a-clickhouse-password

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=replace-with-a-grafana-password
APP_ENV=development
TARANTOOL_DSN=tarantool:3301
