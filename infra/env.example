# ======================================================
# MySQL
# ======================================================

MYSQL_ROOT_PASSWORD=change_root_password
MYSQL_DATABASE=ad_platform
MYSQL_USER=dev
MYSQL_PASSWORD=devpass

# auth-api (SQLAlchemy)
DATABASE_URL=mysql+pymysql://dev:devpass@mysql:3306/ad_platform

# ads-api (Go, sqlx)
DB_DSN=dev:devpass@tcp(mysql:3306)/ad_platform?parseTime=true

# mysqld-exporter
MYSQL_EXPORTER_USER=metrics
MYSQL_EXPORTER_PASSWORD=metrics_password

# ======================================================
# Auth API
# ======================================================

# ОБЯЗАТЕЛЬНО минимум 32 символа
SECRET_KEY=change_me_to_super_long_random_string_min_32_chars
# Email-адреса, которые получают роль admin при регистрации (через запятую)
ADMIN_EMAILS=admin@example.com

# ======================================================
# RabbitMQ
# ======================================================

RABBITMQ_URL=amqp://dev_user:RabbitPass_2026!@rabbitmq:5672/
RABBITMQ_DEFAULT_USER=dev_user
RABBITMQ_DEFAULT_PASS=RabbitPass_2026!

# ======================================================
# Redis
# ======================================================

# если будет авторизация — можно добавить пароль
# REDIS_PASSWORD=

# ======================================================
# ClickHouse
# ======================================================

CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=analytics
CLICKHOUSE_USERNAME=analytics
CLICKHOUSE_PASSWORD=AnalyticsPass_2026!

# ======================================================
# Grafana
# ======================================================

GF_SECURITY_ADMIN_USER=admin1
GF_SECURITY_ADMIN_PASSWORD=admin1!
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,admin-panel

# ======================================================
# Environment
# ======================================================

APP_ENV=development

# ======================================================
# Tarantool
# ======================================================

TARANTOOL_DSN=tarantool:33013
